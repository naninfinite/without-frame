# Normalise text files
* text=auto eol=lf

# Godot files are text
*.gd text
*.tscn text
*.tres text
*.godot text

# Large media through Git LFS (run `git lfs install` once per machine)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
devlog/media/**/*.png filter=lfs diff=lfs merge=lfs -text
devlog/media/**/*.jpg filter=lfs diff=lfs merge=lfs -text

# Small binary assets stay in git
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
